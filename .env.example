# ════════════════════════════════════════
# Environment Variables Template
# 노무Pro 환경 변수 설정
# ════════════════════════════════════════

# ⚠️ 주의사항:
# 1. 이 파일을 복사하여 `.env.local` 파일 생성
# 2. 실제 값으로 교체
# 3. `.env.local`은 절대 Git에 커밋하지 말 것!

# ════════ Supabase Configuration ════════

# Supabase 프로젝트 URL
# Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon (Public) Key
# Supabase Dashboard → Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (서버 사이드에서만 사용)
# ⚠️ 주의: 이 키는 절대 클라이언트에 노출되면 안 됩니다!
# Supabase Dashboard → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ════════ Database Configuration ════════

# [Production/Vercel] Connection pooler (Port 6543)
# ⚠️ 중요: 비밀번호에 '!!' 등 특수문자가 있다면 '%21%21'로 인코딩해야 합니다.
# 예: Guswk0925!! -> Guswk0925%21%21
DATABASE_URL="postgresql://postgres.[PROJECT-ID]:[ENCODED-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# [Migration] Direct connection (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-ID]:[ENCODED-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ════════ Next.js Configuration ════════

# 환경 (development, production, test)
NODE_ENV=development

# 앱 URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ════════ Claude AI (Anthropic) ════════

# Anthropic API Key
# https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Claude 모델 (기본값: claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ════════ Vercel (배포 시) ════════

# Vercel 프로젝트 ID
VERCEL_PROJECT_ID=your-vercel-project-id

# Vercel Team ID
VERCEL_TEAM_ID=your-vercel-team-id

# ════════ Authentication (선택) ════════

# NextAuth Secret (nextauth 사용 시)
# openssl rand -base64 32 로 생성
NEXTAUTH_SECRET=your-nextauth-secret-here

# NextAuth URL
NEXTAUTH_URL=http://localhost:3000

# ════════ 결제 (토스페이먼츠) ════════

# 토스페이먼츠 Client Key
NEXT_PUBLIC_TOSS_CLIENT_KEY=your-toss-client-key

# 토스페이먼츠 Secret Key (서버 사이드)
TOSS_SECRET_KEY=your-toss-secret-key

# ════════ SMS (알리고 또는 Coolsms) ════════

# SMS API Key
SMS_API_KEY=your-sms-api-key

# SMS API Secret
SMS_API_SECRET=your-sms-api-secret

# ════════ 기타 ════════

# Sentry DSN (에러 트래킹)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Google Analytics ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ════════════════════════════════════════
# 사용 방법:
# 1. 이 파일을 `.env.local`로 복사
#    cp .env.example .env.local
# 2. 각 값을 실제 키로 교체
# 3. Next.js 재시작 (npm run dev)
# ════════════════════════════════════════
